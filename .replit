# Replit reads this file. "Run" starts the dev server (React + API on one port).
run = "npm install && npm run dev"
modules = ["nodejs-20", "web"]

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm start"]

[nix]
channel = "stable-25_05"
